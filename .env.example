# Jira风险分析平台 - 环境变量配置
# 将此文件复制为 .env 并填写实际值

# ========== Jira 配置 ==========
# Jira服务器地址（公司内网地址）
JIRA_URL=http://jira.transsion.com

# Jira用户名（建议使用共享账号）
JIRA_USERNAME=jira_robot

# Jira密码（共享账号密码）
JIRA_PASSWORD=your_shared_password_here

# ========== AI 服务配置 ==========
# AI服务地址（公司内网代理）
AI_BASE_URL=https://hk-intra-paas.transsion.com/tranai-proxy/v1

# AI API密钥
AI_API_KEY=sk_your_ai_api_key_here

# AI模型
AI_MODEL=gpt-5.4

# AI代理鉴权信息
X_USER_NO=your_employee_number
X_USER_NAME=your_name
X_USER_DEPT_NAME=your_department_name

# ========== 可选配置 ==========
# 调试模式（true/false）
DEBUG=false

# 日志级别（debug/info/warning/error）
LOG_LEVEL=info